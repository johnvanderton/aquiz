# Copiez ce fichier en ".env" (ou exportez ces variables) — tout est optionnel.
# Le projet ne lit pas .env tout seul : utilisez par exemple
#   node --env-file=.env server/index.js      (Node >= 20.6)

PORT=3000
HOST=0.0.0.0

# Emplacement du fichier SQLite (défaut : server/data/quiz.db)
# DB_PATH=/var/lib/quiz/quiz.db

# Valeurs utilisées UNIQUEMENT au tout premier démarrage (base vide) :
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choisissez-un-mot-de-passe-solide
# ADMIN_ALLOWED_DOMAINS=localhost,127.0.0.1,mon-domaine.be

# À activer dès que le site est servi en HTTPS :
# COOKIE_SECURE=true

# Derrière un reverse proxy (nginx, Caddy...) :
# TRUST_PROXY=true
